# Copie este arquivo para ".env.local" e preencha com suas chaves reais.
# O ".env.local" nunca deve ser enviado ao GitHub (já está no .gitignore).

# Supabase (banco de dados + autenticação)
# Pegue em: seu projeto no supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (pagamentos) — preenchido quando formos implementar o checkout
STRIPE_SECRET_KEY=
